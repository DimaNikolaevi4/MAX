# Секреты и локальные файлы: вся папка local/ кроме шаблона токенов
local/*
!local/tokens.example.json

# Прочие секреты
.env
.env.*

# Служебные файлы
*.log
vendor/
node_modules/
__pycache__/
.idea/
.vscode/
Thumbs.db
.DS_Store

# Материалы канала «nev»: исходники статей и картинки — только локально.
# Правило владельца 10.11.2026: эти бинарники в GitHub не выкладываем,
# иначе каждый коммит тянет десятки мегабайт. Подробнее — AGENTS.md, раздел 2в.
nev/**/*.docx
nev/**/*.png
nev/**/*.jpeg
nev/**/*.jpg
nev/**/*.webp
nev/posting/images/
